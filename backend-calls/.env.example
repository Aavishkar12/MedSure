# ---------- Core ----------
DATABASE_URL=postgresql+psycopg://medsure:medsure@localhost:5432/medsure
JWT_SECRET=change-me-to-a-long-random-string
# Public https URL Twilio can reach (use `ngrok http 8000` while developing)
BASE_URL=https://YOUR-NGROK-SUBDOMAIN.ngrok-free.app

# ---------- Escalation ----------
ACK_WINDOW_SECONDS=60         # how long to wait for one family member before moving to the next
CANCEL_WINDOW_SECONDS=0       # >0 gives the patient a "tapped by mistake" window; 0 = fire instantly
POLL_SECONDS=2
RUN_WORKER_IN_API=false       # true = run the escalation loop inside the API process (handy for demos)

# ---------- Dev conveniences (turn OFF in production) ----------
DEV_MODE=true                 # prints OTPs in the server log instead of requiring SMS/email providers
DEV_OTP=123456                # if set (and DEV_MODE=true) this code is always accepted

# ---------- Firebase Cloud Messaging (push) ----------
# Firebase console > Project settings > Service accounts > Generate new private key
FCM_CREDENTIALS_FILE=./firebase-service-account.json

# ---------- Twilio (voice calls + SMS) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX       # a Twilio voice-capable number
TWILIO_SMS_FROM=                      # optional; defaults to TWILIO_FROM_NUMBER
TWILIO_VALIDATE_SIGNATURE=true

# ---------- Email OTP (optional; logged in DEV_MODE if blank) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MedSure <no-reply@example.com>
