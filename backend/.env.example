# Copy to .env and fill in. Never commit .env.

# Hosted Postgres connection string, e.g. from Neon:
#   postgresql://user:password@host/dbname?sslmode=require
# Leave as SQLite to run without a database server.
DATABASE_URL=sqlite:///./medsure.db

# Firebase service account: Firebase console > Project settings > Service accounts > Generate new private key.
# Either a path to the downloaded file, or the whole JSON on one line (for hosted env vars).
FIREBASE_CREDENTIALS=./firebase-service-account.json

# true lets requests authenticate with an X-User-Id header instead of a Firebase token.
# Local development only. Leave false on anything reachable from the internet.
AUTH_DEV_BYPASS=true

GROQ_API_KEY=
# Check console.groq.com/docs/models for current names before the demo.
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

UPLOAD_DIR=./uploads
